<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PetInsulinTracker.ViewModels"
             x:Class="PetInsulinTracker.Views.AddMedicationLogPage"
             x:DataType="vm:MedicationLogViewModel"
             Title="Log Medication"
             BackgroundColor="{DynamicResource PageBackground}"
             Shell.PresentationMode="ModalAnimated">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="LOG MEDICATION" Style="{StaticResource OverlineStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Medication" Style="{StaticResource FormLabelStyle}" />

                        <!-- Quick-select chips from medication schedules -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding MedicationNameSuggestions}"
                                    Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                    IsVisible="{Binding ShowSuggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding .}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            FontSize="12"
                                            HeightRequest="32"
                                            Padding="12,0"
                                            Margin="0,0,6,6"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectMedicationNameCommand}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Entry Text="{Binding MedicationName}" Placeholder="e.g., Pred 5mg" />
                        <Label Text="Required to save" FontSize="12" TextColor="{DynamicResource Tertiary}"
                               IsVisible="{Binding MedicationName, Converter={StaticResource IsNotNullOrEmptyConverter}, ConverterParameter=invert}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Date" Style="{StaticResource FormLabelStyle}" />
                            <DatePicker Date="{Binding LogDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Time" Style="{StaticResource FormLabelStyle}" />
                            <TimePicker Time="{Binding LogTime}" Format="h:mm tt" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notes" Style="{StaticResource FormLabelStyle}" />
                        <Entry Text="{Binding Notes}" Placeholder="Optional notes" />
                    </VerticalStackLayout>

                    <Button Text="Save" Command="{Binding SaveAndCloseCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="Fill" />
                    <Button Text="Cancel" Command="{Binding CloseModalCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalOptions="Fill" />
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsSyncing}" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsSyncing}" HeightRequest="14" WidthRequest="14"
                                           Color="{DynamicResource Primary}" />
                        <Label Text="Syncing..." Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
